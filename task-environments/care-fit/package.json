{
  "$schema": "../../schemas/task-environment.schema.json",
  "schema_version": "lab-task-environment.v1",
  "id": "care-fit",
  "version": "0.1.0",
  "purpose": "Compare synthetic documentary service and schedule facts against a fictional recurring afterschool-care need.",
